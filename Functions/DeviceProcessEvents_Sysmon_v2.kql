// ============================================================================
// DeviceProcessEvents_Sysmon.kql (v2 - Initial Production Skeleton)
// Built on top of SysmonBase()
// ============================================================================

SysmonBase()
| where EventID in (1,5,7,8,10,25)

// -----------------------------------------------------------------------------
// Common derived fields
// -----------------------------------------------------------------------------
| extend
    FileName = extract(@"([^\\]+)$", 1, Image),
    InitiatingProcessFileName = extract(@"([^\\]+)$", 1, ParentImage),

    AccountDomain = iff(User contains "\\", split(User, "\\")[0], ""),
    AccountName = iff(User contains "\\", split(User, "\\")[1], User),

    InitiatingProcessAccountDomain = iff(ParentUser contains "\\", split(ParentUser, "\\")[0], ""),
    InitiatingProcessAccountName = iff(ParentUser contains "\\", split(ParentUser, "\\")[1], ParentUser)

// -----------------------------------------------------------------------------
// ActionType
// -----------------------------------------------------------------------------
| extend
    ActionType =
        case(
            EventID == 1,  "ProcessCreated",
            EventID == 5,  "ProcessTerminated",
            EventID == 7,  "ImageLoaded",
            EventID == 8,  "CreateRemoteThread",
            EventID == 10, "OpenProcess",
            EventID == 25, "ProcessTampering",
            "Unknown")

// -----------------------------------------------------------------------------
// Derived values
// -----------------------------------------------------------------------------
| extend
    ProcessTokenElevation =
        case(
            IntegrityLevel =~ "System", "Full",
            IntegrityLevel =~ "High", "Full",
            IntegrityLevel =~ "Medium", "Limited",
            IntegrityLevel =~ "Low", "Limited",
            IntegrityLevel =~ "AppContainer", "AppContainer",
            ""),

    ReportId = abs(hash(strcat(Computer, "|", ProcessGuid, "|", tostring(UtcTime)))),

    AdditionalFields = bag_pack(
        "SysmonEventID", EventID,
        "RuleName", RuleName,
        "ProcessGuid", ProcessGuid,
        "ParentProcessGuid", ParentProcessGuid,
        "IntegrityLevel", IntegrityLevel,
        "TerminalSessionId", TerminalSessionId
    )

// -----------------------------------------------------------------------------
// Defender-compatible projection (initial)
// -----------------------------------------------------------------------------
| project
    Timestamp = TimeGenerated,
    DeviceId = "",
    DeviceName = Computer,
    ActionType,

    FileName,
    FolderPath = Image,

    SHA1,
    SHA256,
    MD5,

    ProcessId,
    ProcessUniqueId = ProcessGuid,
    ProcessCommandLine = CommandLine,
    ProcessCreationTime = UtcTime,

    ProcessVersionInfoCompanyName = Company,
    ProcessVersionInfoProductName = Product,
    ProcessVersionInfoOriginalFileName = OriginalFileName,
    ProcessVersionInfoFileDescription = Description,
    ProcessVersionInfoFileVersion = FileVersion,

    ProcessIntegrityLevel = IntegrityLevel,
    ProcessTokenElevation,

    AccountDomain,
    AccountName,
    AccountSid = "",
    AccountUpn = "",
    AccountObjectId = "",

    LogonId,

    InitiatingProcessId = ParentProcessId,
    InitiatingProcessUniqueId = ParentProcessGuid,
    InitiatingProcessFileName,
    InitiatingProcessFolderPath = ParentImage,
    InitiatingProcessCommandLine = ParentCommandLine,

    InitiatingProcessAccountDomain,
    InitiatingProcessAccountName,

    InitiatingProcessSHA1 = "",
    InitiatingProcessSHA256 = "",
    InitiatingProcessMD5 = "",

    ReportId,
    AdditionalFields
